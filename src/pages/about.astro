---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About"
  description="What TheGodotAssetHub is, and how the free resource curation works."
>
  <section class="container page-head">
    <p class="mono eyebrow">About the hub</p>
    <h1>A funky shelf for Godot stuff</h1>
    <p>
      TheGodotAssetHub is a third-party catalog — not the official Godot Asset Library. We point you
      at free community resources, ship a few of our own assets, and keep a shader corner loud and
      useful.
    </p>
  </section>

  <section class="container about-grid">
    <article>
      <h2>How curation works</h2>
      <p>
        Resources are hand-picked outbound links. We credit authors, show license notes when we
        have them, and expect you to verify terms before shipping a commercial project.
      </p>
    </article>
    <article>
      <h2>External vs ours</h2>
      <p>
        Anything labeled <span class="tag mono tag-coral">External</span> belongs to someone else.
        Anything labeled <span class="tag mono tag-lime">Ours</span> is from this hub. Shaders in
        the gallery are provided for learning and remixing in Godot.
      </p>
    </article>
    <article>
      <h2>What’s next</h2>
      <p>
        More tiny asset drops, more shader previews, and tighter 3D showcase pages as packs land.
        No accounts, no uploads — just a sharp place to browse.
      </p>
    </article>
  </section>
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    gap: 1.25rem;
    padding-bottom: 4rem;
  }

  @media (min-width: 800px) {
    .about-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .about-grid article {
    padding: 1.25rem 0;
    border-top: 1px solid var(--line);
  }

  .about-grid h2 {
    margin: 0 0 0.65rem;
    font-size: 1.35rem;
    letter-spacing: -0.03em;
  }

  .about-grid p {
    margin: 0;
    color: var(--steel-bright);
  }
</style>

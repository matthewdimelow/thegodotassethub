---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroStage from "../components/HeroStage";
import FloatStage from "../components/FloatStage";
import resources from "../data/resources.json";
import assets from "../data/assets.json";
import type { Resource } from "../data/types";
import type { HubAsset } from "../data/types";

const featured = (resources as Resource[]).slice(0, 4);
const drop = (assets as HubAsset[]).find((a) => a.id === "dimeplayer") ?? (assets as HubAsset[])[0];
const marquee = [
  "DimePlayer",
  "Mixamo",
  "Free Animation",
  "Play MP4 in Godot",
  ...featured.map((r) => r.title),
  "Shaders",
  "Free Plugin",
  "Godot 4.3+",
  "Community Picks",
];
---

<BaseLayout
  title="AIGameDevHub"
  description="Funky hub for free AI & game-dev tools — Godot resources, animation, assets, and shaders."
>
  <section class="hero">
    <div class="hero-stage-wrap" aria-hidden="true">
      <HeroStage client:load />
      <div class="hero-veil"></div>
      <div class="hero-orb hero-orb-a" data-parallax="0.08"></div>
      <div class="hero-orb hero-orb-b" data-parallax="0.14"></div>
    </div>

    <div class="container hero-copy">
      <p class="mono eyebrow hero-anim" style="animation-delay: 80ms">Free AI · Game-dev hub</p>
      <h1 class="hero-anim" style="animation-delay: 160ms">AIGameDevHub</h1>
      <p class="hero-lead hero-anim" style="animation-delay: 260ms">
        Free tools and resources for game makers — Godot finds, animation, our drops, and shaders.
      </p>
      <div class="hero-ctas hero-anim" style="animation-delay: 360ms">
        <a class="btn btn-lime" href="/resources">Browse free resources</a>
        <a class="btn btn-ghost" href="/animations">Animation tools</a>
        <a class="btn btn-ghost" href="/shaders">Enter shaders</a>
      </div>
      <p class="mono scroll-hint hero-anim" style="animation-delay: 520ms">Scroll to dive in</p>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[...marquee, ...marquee].map((item) => <span>{item}</span>)}
    </div>
  </div>

  <section class="story">
    <div class="story-sticky">
      <div class="story-visual" aria-hidden="true">
        <FloatStage client:load modelUrl="/models/godot-logo.glb" />
      </div>
      <div class="story-copy">
        <p class="mono eyebrow" data-reveal>Not a quiet docs site</p>
        <h2 data-reveal>
          A funky shelf for free game-dev loot — curated finds, animation tools, plus our own drops.
        </h2>
        <p data-reveal>
          Drag through the portals below. External resources stay credited to their authors.
          Ours are labeled clearly. Shaders come ready to copy.
        </p>
      </div>
    </div>
  </section>

  <section class="portals">
    <div class="container portals-head">
      <p class="mono eyebrow" data-reveal>Pick a lane</p>
      <h2 data-reveal>Four doors. Same free energy.</h2>
    </div>
    <div class="portal-track" data-hscroll>
      <a class="portal" href="/resources" data-reveal>
        <div class="portal-stage" aria-hidden="true">
          <FloatStage client:visible variant="shards" />
        </div>
        <div class="portal-copy">
          <span class="tag mono tag-coral">External</span>
          <h3>Resources</h3>
          <p>Free community gold — Kenney, Quaternius, GDQuest, and more.</p>
          <span class="mono portal-go">Enter →</span>
        </div>
      </a>
      <a class="portal" href="/animations" data-reveal>
        <div class="portal-stage" aria-hidden="true">
          <FloatStage client:visible variant="ring" />
        </div>
        <div class="portal-copy">
          <span class="tag mono tag-coral">Always free</span>
          <h3>Animation</h3>
          <p>Mixamo, Blender, Cascadeur, AccuRIG — motion tools for Godot.</p>
          <span class="mono portal-go">Enter →</span>
        </div>
      </a>
      <a class="portal" href="/assets" data-reveal>
        <div class="portal-stage" aria-hidden="true">
          <FloatStage client:visible variant="gem" />
        </div>
        <div class="portal-copy">
          <span class="tag mono tag-lime">Ours</span>
          <h3>Assets</h3>
          <p>DimePlayer for MP4 playback, plus more tiny drops on the way.</p>
          <span class="mono portal-go">Enter →</span>
        </div>
      </a>
      <a class="portal" href="/shaders" data-reveal>
        <div class="portal-stage" aria-hidden="true">
          <FloatStage client:visible variant="shards" />
        </div>
        <div class="portal-copy">
          <span class="tag mono tag-lime">Live code</span>
          <h3>Shaders</h3>
          <p>Rim lights, scan wipes, liquid metal — copy and remix.</p>
          <span class="mono portal-go">Enter →</span>
        </div>
      </a>
    </div>
  </section>

  {
    drop && (
      <section class="drop container">
        <a class="drop-card" href={`/assets/${drop.id}`} data-reveal>
          <div class="drop-media">
            <img src={drop.preview} alt="" loading="lazy" />
          </div>
          <div class="drop-copy">
            <p class="mono eyebrow">New drop · Ours</p>
            <h2>{drop.title}</h2>
            <p>{drop.summary}</p>
            <div class="media-meta">
              <span class="tag mono tag-lime">{drop.godotVersion}</span>
              <span class="tag mono tag-coral">Free on itch.io</span>
              {drop.tags.slice(0, 3).map((tag) => (
                <span class="tag mono">{tag}</span>
              ))}
            </div>
            <span class="btn btn-lime" style="margin-top: 1.25rem">View DimePlayer</span>
          </div>
        </a>
      </section>
    )
  }

  <section class="featured container">
    <div class="featured-head">
      <div>
        <p class="mono eyebrow" data-reveal>On the shelf</p>
        <h2 data-reveal>Hot free picks</h2>
      </div>
      <a class="btn btn-ghost" href="/resources" data-reveal>See all resources</a>
    </div>
    <div class="featured-strip">
      {
        featured.map((item, i) => (
          <a
            class="featured-card media-tile"
            href={`/resources/${item.id}`}
            data-reveal
            style={`transition-delay: ${i * 80}ms`}
          >
            <div class="media-tile-media">
              <img src={item.preview} alt="" loading="lazy" />
            </div>
            <div class="media-tile-body">
              <span class="tag mono tag-coral">External</span>
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="finale">
    <div class="finale-bg" aria-hidden="true">
      <FloatStage client:visible variant="gem" />
    </div>
    <div class="container finale-copy" data-reveal>
      <p class="mono eyebrow">Ready?</p>
      <h2>Jump into the hub.</h2>
      <p>Browse free finds, peek at our assets, or steal a shader for your next prototype.</p>
      <div class="hero-ctas">
        <a class="btn btn-lime" href="/resources">Start with resources</a>
        <a class="btn btn-coral" href="/shaders">Open shaders</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    overflow: clip;
  }

  .hero-stage-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(10, 11, 13, 0.9) 0%, rgba(10, 11, 13, 0.5) 48%, rgba(10, 11, 13, 0.15) 100%),
      linear-gradient(180deg, rgba(10, 11, 13, 0.15) 0%, rgba(10, 11, 13, 0.1) 40%, rgba(10, 11, 13, 0.94) 100%);
    pointer-events: none;
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .hero-orb-a {
    width: 280px;
    height: 280px;
    right: 12%;
    top: 18%;
    background: rgba(200, 245, 66, 0.22);
  }

  .hero-orb-b {
    width: 220px;
    height: 220px;
    right: 28%;
    bottom: 22%;
    background: rgba(255, 90, 60, 0.2);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    padding: calc(var(--nav-h) + 3rem) 0 4.5rem;
    max-width: min(100% - 2rem, 720px);
    margin-left: max(1rem, calc((100% - var(--max)) / 2));
  }

  .hero-copy h1 {
    margin: 0;
    font-size: clamp(3.2rem, 10vw, 6.4rem);
    line-height: 0.88;
    letter-spacing: -0.06em;
    font-weight: 800;
    max-width: 10ch;
    text-wrap: balance;
  }

  .hero-lead {
    margin: 1.25rem 0 0;
    max-width: 34ch;
    color: var(--steel-bright);
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .scroll-hint {
    margin: 2rem 0 0;
    color: var(--steel);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .scroll-hint::before {
    content: "";
    width: 1px;
    height: 2rem;
    background: linear-gradient(var(--lime), transparent);
    animation: pulse-line 1.6s ease-in-out infinite;
  }

  .hero-anim {
    animation: brand-in 0.85s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .marquee {
    border-block: 1px solid var(--line);
    background: rgba(18, 20, 26, 0.65);
    overflow: hidden;
    padding: 0.9rem 0;
  }

  .marquee-track {
    display: flex;
    gap: 2.5rem;
    width: max-content;
    animation: marquee 28s linear infinite;
  }

  .marquee-track span {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--steel-bright);
    white-space: nowrap;
  }

  .marquee-track span::before {
    content: "◆";
    color: var(--lime);
    margin-right: 2.5rem;
  }

  .story {
    padding: 5rem 0 2rem;
  }

  .story-sticky {
    width: min(100% - 2rem, var(--max));
    margin-inline: auto;
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .story-sticky {
      grid-template-columns: 0.9fr 1.1fr;
      min-height: 70vh;
    }
  }

  .story-visual {
    height: min(52vw, 380px);
    min-height: 260px;
    border-radius: 24px;
    border: 1px solid var(--line);
    background:
      radial-gradient(circle at 30% 30%, rgba(255, 90, 60, 0.18), transparent 50%),
      #0d1016;
    overflow: hidden;
  }

  .story-copy h2 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.4rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
    max-width: 16ch;
  }

  .story-copy p:last-child {
    color: var(--steel-bright);
    max-width: 42ch;
    font-size: 1.05rem;
  }

  .portals {
    padding: 3rem 0 4rem;
  }

  .portals-head {
    margin-bottom: 1.5rem;
  }

  .portals-head h2 {
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 3rem);
    letter-spacing: -0.04em;
  }

  .portal-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(280px, 78vw);
    gap: 1rem;
    overflow-x: auto;
    padding: 0.5rem max(1rem, calc((100% - var(--max)) / 2)) 1.25rem;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    cursor: grab;
  }

  .portal-track.is-dragging {
    cursor: grabbing;
  }

  @media (min-width: 1100px) {
    .portal-track {
      grid-auto-columns: minmax(320px, calc((var(--max) - 2rem) / 3));
    }
  }

  .portal {
    scroll-snap-align: start;
    position: relative;
    min-height: 420px;
    border-radius: 22px;
    border: 1px solid var(--line);
    overflow: hidden;
    background: #0d1016;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    transition: transform 0.35s ease, border-color 0.35s ease;
  }

  .portal:hover {
    transform: translateY(-6px) scale(1.01);
    border-color: rgba(200, 245, 66, 0.45);
  }

  .portal-stage {
    position: absolute;
    inset: 0;
    opacity: 0.85;
  }

  .portal-copy {
    position: relative;
    z-index: 1;
    padding: 1.4rem;
    background: linear-gradient(180deg, transparent, rgba(10, 11, 13, 0.92) 40%);
  }

  .portal-copy h3 {
    margin: 0.55rem 0 0;
    font-size: 2rem;
    letter-spacing: -0.04em;
  }

  .portal-copy p {
    margin: 0.45rem 0 0;
    color: var(--steel-bright);
    max-width: 28ch;
  }

  .portal-go {
    display: inline-block;
    margin-top: 1rem;
    color: var(--lime);
  }

  .drop {
    padding: 1rem 0 2rem;
  }

  .drop-card {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 22px;
    overflow: hidden;
    background:
      radial-gradient(circle at 85% 20%, rgba(200, 245, 66, 0.12), transparent 40%),
      radial-gradient(circle at 10% 80%, rgba(255, 90, 60, 0.12), transparent 45%),
      rgba(18, 20, 26, 0.7);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .drop-card:hover {
    transform: translateY(-4px);
    border-color: rgba(200, 245, 66, 0.4);
  }

  @media (min-width: 860px) {
    .drop-card {
      grid-template-columns: 1.05fr 1fr;
    }
  }

  .drop-media {
    min-height: 320px;
    max-height: 480px;
    background: #07080b;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .drop-media img {
    width: 100%;
    height: 100%;
    min-height: 320px;
    max-height: 480px;
    object-fit: contain;
    object-position: center;
  }

  .drop-copy {
    padding: 1.5rem 1.5rem 1.75rem;
  }

  .drop-copy h2 {
    margin: 0;
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .drop-copy > p:not(.eyebrow) {
    margin: 0.75rem 0 0;
    color: var(--steel-bright);
    max-width: 40ch;
  }

  .featured {
    padding: 2rem 0 5rem;
  }

  .featured-head {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 1.5rem;
  }

  .featured-head h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.8rem);
    letter-spacing: -0.04em;
  }

  .featured-strip {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 800px) {
    .featured-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .featured-card {
    animation: none;
  }

  .finale {
    position: relative;
    min-height: 70vh;
    display: grid;
    place-items: center;
    overflow: clip;
    border-top: 1px solid var(--line);
  }

  .finale-bg {
    position: absolute;
    inset: 10% 20%;
    opacity: 0.45;
    pointer-events: none;
  }

  .finale-copy {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 4rem 0;
  }

  .finale-copy h2 {
    margin: 0;
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .finale-copy p {
    margin: 1rem auto 0;
    max-width: 36ch;
    color: var(--steel-bright);
  }

  .finale-copy .hero-ctas {
    justify-content: center;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes pulse-line {
    0%,
    100% {
      transform: scaleY(0.55);
      opacity: 0.4;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @media (max-width: 720px) {
    .hero-copy {
      margin-left: 1rem;
      padding-bottom: 3rem;
    }

    .hero-veil {
      background: linear-gradient(
        180deg,
        rgba(10, 11, 13, 0.3) 0%,
        rgba(10, 11, 13, 0.8) 55%,
        rgba(10, 11, 13, 0.96) 100%
      );
    }
  }
</style>

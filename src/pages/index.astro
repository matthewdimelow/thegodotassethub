---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroStage from "../components/HeroStage";
import FloatStage from "../components/FloatStage";
import resources from "../data/resources.json";
import aiTools from "../data/ai-tools.json";
import assets from "../data/assets.json";
import type { Resource } from "../data/types";
import type { HubAsset } from "../data/types";

const featuredAi = (aiTools as Resource[]).slice(0, 3);
const featuredRes = (resources as Resource[]).slice(0, 3);
const drop = (assets as HubAsset[]).find((a) => a.id === "dimeplayer") ?? (assets as HubAsset[])[0];
const marquee = [
  "Ollama",
  "ComfyUI",
  "Mixamo",
  "TripoSR",
  "Godot",
  "Whisper",
  "Free forever lane",
  "Local LLMs",
  "DimePlayer",
  "Always free",
];
---

<BaseLayout
  title="AIGameDevHub"
  description="Free AI & game-dev tools hub — local LLMs, art pipelines, animation, Godot resources, and shaders."
>
  <section class="hero">
    <div class="hero-stage-wrap" aria-hidden="true">
      <HeroStage client:load />
      <div class="hero-veil"></div>
      <div class="signal-ring" data-parallax="0.06"></div>
    </div>

    <div class="container hero-copy">
      <p class="mono eyebrow hero-anim" style="animation-delay: 60ms">Free AI · Game systems</p>
      <h1 class="hero-anim" style="animation-delay: 140ms">
        AIGame<span class="brand-accent">Dev</span>Hub
      </h1>
      <p class="hero-lead hero-anim" style="animation-delay: 240ms">
        Free tools for builders who ship games — local AI, motion, Godot loot, and loud shaders.
      </p>
      <div class="hero-ctas hero-anim" style="animation-delay: 340ms">
        <a class="btn btn-lime" href="/godot">Why Godot</a>
        <a class="btn btn-ghost" href="/coding">Explore coding</a>
        <a class="btn btn-ghost" href="/modeling">Modeling</a>
      </div>
      <p class="mono scroll-hint hero-anim" style="animation-delay: 480ms">Scroll the signal</p>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[...marquee, ...marquee].map((item) => <span>{item}</span>)}
    </div>
  </div>

  <section class="manifesto">
    <div class="container manifesto-grid">
      <div class="manifesto-visual" aria-hidden="true" data-reveal>
        <FloatStage client:load modelUrl="/models/godot-logo.glb" />
        <div class="manifesto-hud mono">
          <span>SIGNAL // OPEN</span>
          <span>COST // $0</span>
        </div>
      </div>
      <div class="manifesto-copy">
        <p class="mono eyebrow" data-reveal>Why this hub</p>
        <h2 data-reveal>Game-dev with AI energy — without the paywall fog.</h2>
        <p data-reveal>
          We curate free lanes only: local models, open art tools, animation stacks, Godot finds,
          and our own drops. External links stay credited to their authors.
        </p>
        <div class="lane-pills" data-reveal>
          <span class="tag mono tag-lime">Local AI</span>
          <span class="tag mono tag-coral">Motion</span>
          <span class="tag mono">Godot</span>
          <span class="tag mono">Shaders</span>
        </div>
      </div>
    </div>
  </section>

  <section class="portals">
    <div class="container portals-head">
      <p class="mono eyebrow" data-reveal>Pick a frequency</p>
      <h2 data-reveal>Free doors. Godot first.</h2>
    </div>
    <div class="portal-track">
      <a class="portal portal-hot" href="/godot" data-reveal>
        <div class="portal-stage" aria-hidden="true">
          <FloatStage client:visible modelUrl="/models/godot-logo.glb" />
        </div>
        <div class="portal-copy">
          <span class="tag mono tag-lime">Open source</span>
          <h3>Godot</h3>
          <p>Free forever. MIT licensed. Deserves more love — here’s why.</p>
          <span class="mono portal-go">Enter →</span>
        </div>
      </a>
      <a class="portal" href="/coding" data-reveal>
        <div class="portal-stage" aria-hidden="true">
          <FloatStage client:visible variant="shards" />
        </div>
        <div class="portal-copy">
          <span class="tag mono tag-coral">Tools</span>
          <h3>Coding</h3>
          <p>Ollama, ComfyUI, TripoSR, Whisper — free pipelines for game makers.</p>
          <span class="mono portal-go">Enter →</span>
        </div>
      </a>
      <a class="portal" href="/modeling" data-reveal>
        <div class="portal-stage" aria-hidden="true">
          <FloatStage client:visible variant="gem" />
        </div>
        <div class="portal-copy">
          <span class="tag mono tag-lime">3D</span>
          <h3>Modeling</h3>
          <p>Blender, Blockbench, voxels, cleanup — free tools for game meshes.</p>
          <span class="mono portal-go">Enter →</span>
        </div>
      </a>
      <a class="portal" href="/animations" data-reveal>
        <div class="portal-stage" aria-hidden="true">
          <FloatStage client:visible variant="ring" />
        </div>
        <div class="portal-copy">
          <span class="tag mono tag-coral">Motion</span>
          <h3>Animation</h3>
          <p>Mixamo, Blender, Cascadeur, AccuRIG — get characters moving.</p>
          <span class="mono portal-go">Enter →</span>
        </div>
      </a>
      <a class="portal" href="/resources" data-reveal>
        <div class="portal-stage" aria-hidden="true">
          <FloatStage client:visible variant="gem" />
        </div>
        <div class="portal-copy">
          <span class="tag mono tag-coral">Godot</span>
          <h3>Resources</h3>
          <p>Kenney, Quaternius, GDQuest, Asset Store — free community gold.</p>
          <span class="mono portal-go">Enter →</span>
        </div>
      </a>
      <a class="portal" href="/about" data-reveal>
        <div class="portal-stage" aria-hidden="true">
          <FloatStage client:visible variant="shards" />
        </div>
        <div class="portal-copy">
          <span class="tag mono tag-lime">Hub</span>
          <h3>About</h3>
          <p>What this free hub is — and how we curate the shelves.</p>
          <span class="mono portal-go">Enter →</span>
        </div>
      </a>
      <a class="portal" href="/community" data-reveal>
        <div class="portal-stage" aria-hidden="true">
          <FloatStage client:visible variant="ring" />
        </div>
        <div class="portal-copy">
          <span class="tag mono tag-lime">Live</span>
          <h3>Feed</h3>
          <p>Live Reddit feed from r/aigamedev — demos, workflows, chatter.</p>
          <span class="mono portal-go">Enter →</span>
        </div>
      </a>
    </div>
  </section>

  <section class="featured container">
    <div class="featured-head">
      <div>
        <p class="mono eyebrow" data-reveal>Coding shelf</p>
        <h2 data-reveal>Start here — free coding stack</h2>
      </div>
      <a class="btn btn-ghost" href="/coding" data-reveal>All coding tools</a>
    </div>
    <div class="featured-strip">
      {
        featuredAi.map((item, i) => (
          <a
            class="featured-card media-tile"
            href={`/coding/${item.id}`}
            data-reveal
            style={`transition-delay: ${i * 80}ms`}
          >
            <div class="media-tile-media">
              <img src={item.preview} alt="" loading="lazy" />
            </div>
            <div class="media-tile-body">
              <span class="tag mono tag-lime">Coding</span>
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  {
    drop && (
      <section class="drop container">
        <a class="drop-card" href={`/tools/${drop.id}`} data-reveal>
          <div class="drop-media">
            <img src={drop.preview} alt="" loading="lazy" />
          </div>
          <div class="drop-copy">
            <p class="mono eyebrow">Hub drop · Ours</p>
            <h2>{drop.title}</h2>
            <p>{drop.summary}</p>
            <div class="media-meta">
              <span class="tag mono tag-lime">{drop.godotVersion}</span>
              <span class="tag mono tag-coral">Free on itch.io</span>
              {drop.tags.slice(0, 3).map((tag) => (
                <span class="tag mono">{tag}</span>
              ))}
            </div>
            <span class="btn btn-lime" style="margin-top: 1.25rem">View DimePlayer</span>
          </div>
        </a>
      </section>
    )
  }

  <section class="featured container">
    <div class="featured-head">
      <div>
        <p class="mono eyebrow" data-reveal>Godot shelf</p>
        <h2 data-reveal>Free community picks</h2>
      </div>
      <a class="btn btn-ghost" href="/resources" data-reveal>All resources</a>
    </div>
    <div class="featured-strip">
      {
        featuredRes.map((item, i) => (
          <a
            class="featured-card media-tile"
            href={`/resources/${item.id}`}
            data-reveal
            style={`transition-delay: ${i * 80}ms`}
          >
            <div class="media-tile-media">
              <img src={item.preview} alt="" loading="lazy" />
            </div>
            <div class="media-tile-body">
              <span class="tag mono tag-coral">External</span>
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="finale">
    <div class="finale-bg" aria-hidden="true">
      <FloatStage client:visible variant="shards" />
    </div>
    <div class="container finale-copy" data-reveal>
      <p class="mono eyebrow">Boot sequence</p>
      <h2>Build weird. Stay free.</h2>
      <p>Jump into coding tools, steal a Mixamo clip, or drop a model into Godot before dinner.</p>
      <div class="hero-ctas">
        <a class="btn btn-lime" href="/coding">Open coding</a>
        <a class="btn btn-coral" href="/modeling">Open modeling</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    overflow: clip;
  }

  .hero-stage-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(105deg, rgba(6, 7, 12, 0.92) 0%, rgba(6, 7, 12, 0.45) 48%, rgba(6, 7, 12, 0.12) 100%),
      linear-gradient(180deg, rgba(6, 7, 12, 0.2) 0%, rgba(6, 7, 12, 0.1) 40%, rgba(6, 7, 12, 0.94) 100%);
    pointer-events: none;
  }

  .signal-ring {
    position: absolute;
    width: min(52vw, 520px);
    aspect-ratio: 1;
    right: 8%;
    top: 18%;
    border: 1px solid rgba(93, 255, 177, 0.28);
    border-radius: 50%;
    box-shadow:
      inset 0 0 80px rgba(93, 255, 177, 0.08),
      0 0 60px rgba(255, 107, 44, 0.08);
    pointer-events: none;
    animation: pulse-ring 5.5s ease-in-out infinite;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    padding: calc(var(--nav-h) + 3rem) 0 4.5rem;
    max-width: min(100% - 2rem, 740px);
    margin-left: max(1rem, calc((100% - var(--max)) / 2));
  }

  .hero-copy h1 {
    margin: 0;
    font-size: clamp(2.8rem, 8.5vw, 5.6rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
    font-weight: 800;
    max-width: none;
    overflow: visible;
    white-space: normal;
    word-break: keep-all;
    color: var(--white);
    text-shadow: 0 0 40px rgba(93, 255, 177, 0.18);
  }

  .hero-copy h1 .brand-accent {
    color: var(--mint);
  }

  .hero-lead {
    margin: 1.35rem 0 0;
    max-width: 34ch;
    color: var(--steel-bright);
    font-size: clamp(1.08rem, 2.2vw, 1.28rem);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .scroll-hint {
    margin: 2rem 0 0;
    color: var(--steel);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .scroll-hint::before {
    content: "";
    width: 1px;
    height: 2rem;
    background: linear-gradient(var(--mint), transparent);
    animation: pulse-line 1.6s ease-in-out infinite;
  }

  .hero-anim {
    animation: brand-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .marquee {
    border-block: 1px solid var(--line);
    background: rgba(15, 20, 28, 0.75);
    overflow: hidden;
    padding: 0.95rem 0;
  }

  .marquee-track {
    display: flex;
    gap: 2.5rem;
    width: max-content;
    animation: marquee 26s linear infinite;
  }

  .marquee-track span {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--steel-bright);
    white-space: nowrap;
  }

  .marquee-track span::before {
    content: "◈";
    color: var(--mint);
    margin-right: 2.5rem;
  }

  .manifesto {
    padding: 5rem 0 3rem;
  }

  .manifesto-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .manifesto-grid {
      grid-template-columns: 0.95fr 1.05fr;
      min-height: 62vh;
    }
  }

  .manifesto-visual {
    position: relative;
    height: min(52vw, 400px);
    min-height: 280px;
    border-radius: 28px;
    border: 1px solid var(--line);
    background:
      radial-gradient(circle at 30% 30%, rgba(93, 255, 177, 0.16), transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(255, 107, 44, 0.14), transparent 45%),
      #0a1018;
    overflow: hidden;
  }

  .manifesto-hud {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--mint);
    text-shadow: 0 0 12px rgba(93, 255, 177, 0.35);
  }

  .manifesto-copy h2 {
    margin: 0;
    font-size: clamp(2.1rem, 5vw, 3.5rem);
    letter-spacing: -0.05em;
    line-height: 0.96;
    max-width: 16ch;
  }

  .manifesto-copy > p:last-of-type {
    color: var(--steel-bright);
    max-width: 42ch;
    font-size: 1.05rem;
  }

  .lane-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.25rem;
  }

  .portals {
    padding: 2rem 0 4rem;
  }

  .portals-head {
    margin-bottom: 1.5rem;
  }

  .portals-head h2 {
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 3.1rem);
    letter-spacing: -0.045em;
  }

  .portal-track {
    width: min(100% - 2rem, var(--max));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 0.5rem 0 1.25rem;
    overflow: visible;
  }

  @media (min-width: 720px) {
    .portal-track {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .portal-track {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .portal {
    position: relative;
    min-height: 360px;
    border-radius: 24px;
    border: 1px solid var(--line);
    overflow: hidden;
    background: #0a1018;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
  }

  .portal:hover {
    transform: translateY(-8px) scale(1.015);
    border-color: rgba(93, 255, 177, 0.45);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
  }

  .portal-hot {
    border-color: rgba(93, 255, 177, 0.35);
  }

  .portal-stage {
    position: absolute;
    inset: 0;
    opacity: 0.88;
  }

  .portal-copy {
    position: relative;
    z-index: 1;
    padding: 1.4rem;
    background: linear-gradient(180deg, transparent, rgba(6, 7, 12, 0.94) 42%);
  }

  .portal-copy h3 {
    margin: 0.55rem 0 0;
    font-size: 2.05rem;
    letter-spacing: -0.045em;
  }

  .portal-copy p {
    margin: 0.45rem 0 0;
    color: var(--steel-bright);
    max-width: 28ch;
  }

  .portal-go {
    display: inline-block;
    margin-top: 1rem;
    color: var(--mint);
  }

  .featured {
    padding: 1.5rem 0 3.5rem;
  }

  .featured-head {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 1.5rem;
  }

  .featured-head h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.9rem);
    letter-spacing: -0.045em;
  }

  .featured-strip {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 800px) {
    .featured-strip {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .featured-card {
    animation: none;
  }

  .drop {
    padding: 1rem 0 3rem;
  }

  .drop-card {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 24px;
    overflow: hidden;
    background:
      radial-gradient(circle at 85% 20%, rgba(93, 255, 177, 0.12), transparent 40%),
      radial-gradient(circle at 10% 80%, rgba(255, 107, 44, 0.12), transparent 45%),
      rgba(15, 20, 28, 0.75);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .drop-card:hover {
    transform: translateY(-4px);
    border-color: rgba(93, 255, 177, 0.4);
  }

  @media (min-width: 860px) {
    .drop-card {
      grid-template-columns: 1.05fr 1fr;
    }
  }

  .drop-media {
    min-height: 320px;
    max-height: 480px;
    background: #07080b;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .drop-media img {
    width: 100%;
    height: 100%;
    min-height: 320px;
    max-height: 480px;
    object-fit: contain;
    object-position: center;
  }

  .drop-copy {
    padding: 1.5rem 1.5rem 1.75rem;
  }

  .drop-copy h2 {
    margin: 0;
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .drop-copy > p:not(.eyebrow) {
    margin: 0.75rem 0 0;
    color: var(--steel-bright);
    max-width: 40ch;
  }

  .finale {
    position: relative;
    min-height: 70vh;
    display: grid;
    place-items: center;
    overflow: clip;
    border-top: 1px solid var(--line);
  }

  .finale-bg {
    position: absolute;
    inset: 8% 18%;
    opacity: 0.4;
    pointer-events: none;
  }

  .finale-copy {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 4rem 0;
  }

  .finale-copy h2 {
    margin: 0;
    font-size: clamp(2.6rem, 8vw, 5rem);
    letter-spacing: -0.06em;
    line-height: 0.92;
  }

  .finale-copy p {
    margin: 1rem auto 0;
    max-width: 36ch;
    color: var(--steel-bright);
  }

  .finale-copy .hero-ctas {
    justify-content: center;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes pulse-line {
    0%,
    100% {
      transform: scaleY(0.55);
      opacity: 0.4;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @keyframes pulse-ring {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.7;
    }
    50% {
      transform: scale(1.04);
      opacity: 1;
    }
  }

  @media (max-width: 720px) {
    .hero-copy {
      margin-left: 1rem;
      padding-bottom: 3rem;
    }

    .hero-veil {
      background: linear-gradient(
        180deg,
        rgba(6, 7, 12, 0.35) 0%,
        rgba(6, 7, 12, 0.82) 55%,
        rgba(6, 7, 12, 0.96) 100%
      );
    }

    .signal-ring {
      opacity: 0.35;
    }
  }
</style>

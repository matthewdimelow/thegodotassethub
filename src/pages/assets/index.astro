---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FilterBar from "../../components/FilterBar.astro";
import MediaTile from "../../components/MediaTile.astro";
import assets from "../../data/assets.json";
import type { HubAsset } from "../../data/types";

const items = assets as HubAsset[];
const categories = [...new Set(items.flatMap((a) => a.tags))].sort();
---

<BaseLayout
  title="Assets"
  description="Simple Godot assets from TheGodotAssetHub — small packs with funky 3D energy."
>
  <section class="container page-head">
    <p class="mono eyebrow" data-reveal>Ours</p>
    <h1 data-reveal>Simple Godot assets</h1>
    <p data-reveal>
      A short shelf of our own drops. Not many — just the funky essentials for prototypes and demos.
    </p>
  </section>

  <section class="container" style="padding-bottom: 4rem">
    <FilterBar categories={categories} target="#asset-grid" />
    <div class="media-grid" id="asset-grid">
      {
        items.map((item, i) => (
          <div data-category={item.tags.join(",")}>
            <MediaTile
              href={`/assets/${item.id}`}
              title={item.title}
              summary={item.summary}
              preview={item.preview}
              tags={[item.godotVersion, item.status === "available" ? "free" : item.status]}
              badge={item.status === "available" ? "New · Ours" : "Ours"}
              badgeTone={item.status === "available" ? "coral" : "lime"}
              delay={i * 70}
            />
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FilterBar from "../../components/FilterBar.astro";
import MediaTile from "../../components/MediaTile.astro";
import tools from "../../data/ai-tools.json";
import type { Resource } from "../../data/types";

const items = tools as Resource[];
const categories = [...new Set(items.map((r) => r.category))].sort();
---

<BaseLayout
  title="Coding"
  description="AI coding tools for game developers — Cursor, Claude, Grok, local LLMs, image gen, and Godot workflows."
>
  <section class="container page-head">
    <p class="mono eyebrow" data-reveal>External · AI + local</p>
    <h1 data-reveal>Coding tools for game makers</h1>
    <p data-reveal>
      AI IDEs and assistants (Cursor, Claude, Grok, and friends), plus local LLMs, image pipelines, and
      Godot helpers. Some have free tiers; open tools stay free. Check each license before shipping.
    </p>
    <p data-reveal style="margin-top: 0.75rem">
      <a class="mono" href="/shaders" style="color: var(--mint)">Shader corner →</a>
    </p>
  </section>

  <section class="container" style="padding-bottom: 4rem">
    <FilterBar categories={categories} target="#coding-grid" />
    <div class="media-grid" id="coding-grid">
      {
        items.map((item, i) => (
          <div data-category={[item.category, ...item.tags].join(",")}>
            <MediaTile
              href={`/coding/${item.id}`}
              title={item.title}
              summary={item.summary}
              preview={item.preview}
              tags={[item.category, item.license]}
              badge="Coding"
              badgeTone="lime"
              delay={i * 70}
            />
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
